UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == config.toggleKey then toggleAim()
	elseif input.KeyCode == config.switchTargetKey and config.enabled then currentTarget = findNewTarget(currentTarget)
	elseif input.KeyCode == config.hideUIKey then
		uiVisible = not uiVisible
		mainFrame.Visible = uiVisible
		fovCircle.Visible = uiVisible
		if not uiVisible then playerListFrame.Visible = false end
	elseif input.KeyCode == config.espToggleKey then toggleESP()
	end
end)

