local function updateCustomTargetUI()
	if config.customTargetEnabled and config.customTargetPlayer then
		customTargetBtn.Text = "Priority Target: " .. config.customTargetPlayer.Name
		customTargetBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
		customTargetBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	else
		customTargetBtn.Text = "Priority Target: OFF"
		customTargetBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		customTargetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
	if config.enabled then currentTarget = getCustomTargetPart() or findNewTarget(nil) end
end

local function refreshPlayerList()
	for _, child in ipairs(scrollingPlayers:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	local totalHeight = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local rowFrame = Instance.new("Frame", scrollingPlayers)
			rowFrame.Size = UDim2.new(1, 0, 0, 25)
			rowFrame.BackgroundTransparency = 1

			local pBtn = Instance.new("TextButton", rowFrame)
			pBtn.Size = UDim2.new(0, 125, 1, 0)
			pBtn.Position = UDim2.new(0, 0, 0, 0)
			pBtn.Font = Enum.Font.SourceSansBold
			pBtn.TextSize = 12
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			
			local isExc = config.exceptions[player.Name]
			pBtn.Text = isExc and "[EXC] " .. player.Name or player.Name
			pBtn.BackgroundColor3 = isExc and Color3.fromRGB(180, 50, 50) or Color3.fromRGB(50, 50, 50)

			pBtn.Activated:Connect(function()
				config.exceptions[player.Name] = not config.exceptions[player.Name]
				refreshPlayerList() 
			end)

			local targetBtn = Instance.new("TextButton", rowFrame)
			targetBtn.Size = UDim2.new(0, 55, 1, 0)
			targetBtn.Position = UDim2.new(0, 130, 0, 0)
			targetBtn.Font = Enum.Font.SourceSansBold
			targetBtn.TextSize = 11

			local isCustom = (config.customTargetPlayer == player)
			targetBtn.Text = isCustom and "[★ PRIO]" or "[PRIO]"
			targetBtn.BackgroundColor3 = isCustom and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(70, 70, 70)
			targetBtn.TextColor3 = isCustom and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)

			targetBtn.Activated:Connect(function()
				if config.customTargetPlayer == player then
					config.customTargetPlayer = nil
					config.customTargetEnabled = false
				else
					config.customTargetPlayer = player
					config.customTargetEnabled = true
				end
				updateCustomTargetUI()
				refreshPlayerList()
			end)

			totalHeight += 30
		end
	end
	scrollingPlayers.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

