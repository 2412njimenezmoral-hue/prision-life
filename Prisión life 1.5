				else
					config.customTargetPlayer = player
					config.customTargetEnabled = true
				end
				refreshPlayerList()
			end)

			totalHeight += 43
		end
	end
	playerTab.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

