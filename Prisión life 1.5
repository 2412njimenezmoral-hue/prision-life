-- Lógica ESP Base
local espDrawings = {}
local function removeESP(player)
	if espDrawings[player] then
		espDrawings[player].box:Destroy()
		espDrawings[player].name:Destroy()
		for _, line in pairs(espDrawings[player].skeleton) do line:Destroy() end
		espDrawings[player] = nil
	end
end
local function setupESP(player)
	if player == LocalPlayer or espDrawings[player] then return end
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Visible = false
	box.Parent = espFolder
	local boxStroke = Instance.new("UIStroke", box)
	boxStroke.Thickness = 1.5

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.AnchorPoint = Vector2.new(0.5, 1)
	nameLabel.Size = UDim2.new(0, 150, 0, 15)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 11
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.Visible = false
	nameLabel.Parent = espFolder

	local function makeLine()
		local line = Instance.new("Frame")
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.BorderSizePixel = 0
		line.Visible = false
		line.Parent = espFolder
		return line
	end

	espDrawings[player] = {
		box = box, stroke = boxStroke, name = nameLabel,
		skeleton = {
			headToTorso = makeLine(), torsoToLeftArm = makeLine(),
			torsoToRightArm = makeLine(), torsoToLeftLeg = makeLine(), torsoToRightLeg = makeLine()
		}
	}
end
for _, p in ipairs(Players:GetPlayers()) do setupESP(p) end
Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(removeESP)

-- Bucle Principal (Aimbot + ESP)
RunService:BindToRenderStep("AimLockSystemPro", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
	if config.enabled then 
		local forcedCustomPart = config.customTargetEnabled and config.customTargetPlayer and getCustomTargetPart() or nil
		if forcedCustomPart then
			currentTarget = forcedCustomPart
		else
			if not config.priorityFocusOn and config.customTargetEnabled and config.customTargetPlayer then
				currentTarget = nil
			else
				if currentTarget and currentTarget.Parent then
					local humanoid = currentTarget.Parent:FindFirstChild("Humanoid")
					local targetPlayer = Players:GetPlayerFromCharacter(currentTarget.Parent)
					local isValid = (humanoid and humanoid.Health > 0 and targetPlayer and isWithinFOV(currentTarget) and isVisible(currentTarget) and isEnemy(targetPlayer))
					if not isValid then currentTarget = nil end
				else currentTarget = nil end
				if not currentTarget then currentTarget = findNewTarget(nil) end
			end
		end

		if currentTarget and currentTarget.Parent then
			local goalCFrame = CFrame.lookAt(Camera.CFrame.Position, currentTarget.Position)
			if config.smoothnessValue <= 1 then Camera.CFrame = goalCFrame
			else
				local speed = 32 - (config.smoothnessValue / 100) * 30
				local alpha = math.clamp(deltaTime * speed, 0, 1)
				Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, alpha)
			end
		end
	end

	-- ESP Render
	if not config.espEnabled then 
		for _, drw in pairs(espDrawings) do 
			drw.box.Visible = false; drw.name.Visible = false
			for _, line in pairs(drw.skeleton) do line.Visible = false end
		end
		return 
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local drawings = espDrawings[player]
		local character = player.Character
		if drawings and character then
			local humanoid = character:FindFirstChild("Humanoid")
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			local head = character:FindFirstChild("Head")

			if humanoid and humanoid.Health > 0 and rootPart and head then
				local topPos = head.Position + Vector3.new(0, 1.2, 0)
				local bottomPos = rootPart.Position - Vector3.new(0, 3.0, 0)
				local topScreen, topOn = Camera:WorldToViewportPoint(topPos)
				local bottomScreen, bottomOn = Camera:WorldToViewportPoint(bottomPos)

				if topOn or bottomOn then
					local height = math.abs(bottomScreen.Y - topScreen.Y)
					local width = height * 0.65
					local centerY = (topScreen.Y + bottomScreen.Y) / 2
					local centerX = topScreen.X

					local teamName = player.Team and player.Team.Name or "No Team"
					local currentEspColor = Color3.fromRGB(200, 200, 200)
					if config.customTargetEnabled and config.customTargetPlayer == player then currentEspColor = Color3.fromRGB(255, 215, 0)
					elseif teamName == "Guards" then currentEspColor = Color3.fromRGB(85, 170, 255)
					elseif teamName == "Inmates" then currentEspColor = Color3.fromRGB(255, 170, 0)
					elseif teamName == "Criminals" then currentEspColor = Color3.fromRGB(255, 85, 85) end

					drawings.stroke.Color = currentEspColor
					drawings.name.TextColor3 = currentEspColor
					for _, line in pairs(drawings.skeleton) do line.BackgroundColor3 = currentEspColor end

					drawings.box.Size = UDim2.new(0, width, 0, height)
					drawings.box.Position = UDim2.new(0, centerX, 0, centerY)
					drawings.box.Visible = config.espBox

					local tag = (config.customTargetEnabled and config.customTargetPlayer == player) and " [★]" or ""
					drawings.name.Text = player.Name .. tag
					drawings.name.Position = UDim2.new(0, centerX, 0, topScreen.Y - 15)
					drawings.name.Visible = config.espName

					if config.espSkeleton then
						local torso = character:FindFirstChild("Torso")
						local leftArm = character:FindFirstChild("Left Arm")
						local rightArm = character:FindFirstChild("Right Arm")
						local leftLeg = character:FindFirstChild("Left Leg")
						local rightLeg = character:FindFirstChild("Right Leg")
						local function getV2(part)
							if part then
								local pos, onS = Camera:WorldToViewportPoint(part.Position)
								if onS then return Vector2.new(pos.X, pos.Y) end
							end
							return nil
						end
						local function updateLine(frame, from, toPart)
							local to = getV2(toPart)
							if from and to then
								local center = (from + to) / 2
								local dist = (from - to).Magnitude
								local angle = math.deg(math.atan2(to.Y - from.Y, to.X - from.X))
								frame.Size = UDim2.new(0, dist, 0, 1.5)
								frame.Position = UDim2.new(0, center.X, 0, center.Y)
								frame.Rotation = angle
								frame.Visible = true
							else frame.Visible = false end
						end
						local headV2 = getV2(head); local tV2 = getV2(torso)
						updateLine(drawings.skeleton.headToTorso, headV2, torso)
						updateLine(drawings.skeleton.torsoToLeftArm, tV2, leftArm)
						updateLine(drawings.skeleton.torsoToRightArm, tV2, rightArm)
						updateLine(drawings.skeleton.torsoToLeftLeg, tV2, leftLeg)
						updateLine(drawings.skeleton.torsoToRightLeg, tV2, rightLeg)
					else for _, line in pairs(drawings.skeleton) do line.Visible = false end end
					continue 
				end
			end
		end
		if drawings then
			drawings.box.Visible = false; drawings.name.Visible = false
			for _, line in pairs(drawings.skeleton) do line.Visible = false end
		end
	end
end)

