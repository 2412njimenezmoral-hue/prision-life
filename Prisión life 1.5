-- Funciones para crear UI Modular
local tabs = {}
local tabButtons = {}

local function switchTab(tabName)
	for name, frame in pairs(tabs) do frame.Visible = (name == tabName) end
	for name, btn in pairs(tabButtons) do 
		btn.BackgroundColor3 = (name == tabName) and Color3.fromRGB(35, 35, 45) or Color3.fromRGB(22, 22, 27)
		btn.TextColor3 = (name == tabName) and Color3.fromRGB(85, 170, 255) or Color3.fromRGB(200, 200, 200)
	end
end

local function CreateTab(name)
	local btn = Instance.new("TextButton", sideBar)
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.Text = "  " .. name
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 14
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.BorderSizePixel = 0
	
	local frame = Instance.new("ScrollingFrame", contentFrame)
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.ScrollBarThickness = 4
	frame.CanvasSize = UDim2.new(0, 0, 0, 0)
	frame.Visible = false
	
	local layout = Instance.new("UIListLayout", frame)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	
	local padding = Instance.new("UIPadding", frame)
	padding.PaddingTop = UDim.new(0, 15)
	padding.PaddingLeft = UDim.new(0, 15)
	padding.PaddingRight = UDim.new(0, 15)
	
	btn.Activated:Connect(function() switchTab(name) end)
	
	tabs[name] = frame
	tabButtons[name] = btn
	return frame
end

local function CreateToggle(parent, text, default, callback)
	local btn = Instance.new("TextButton", parent)
	btn.Size = UDim2.new(1, 0, 0, 35)
	btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	btn.Text = ""
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	
	local label = Instance.new("TextLabel", btn)
	label.Size = UDim2.new(1, -60, 1, 0)
	label.Position = UDim2.new(0, 15, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	
	local status = Instance.new("Frame", btn)
	status.Size = UDim2.new(0, 16, 0, 16)
	status.Position = UDim2.new(1, -30, 0.5, -8)
	Instance.new("UICorner", status).CornerRadius = UDim.new(0, 4)
	
	local state = default
	local function update()
		status.BackgroundColor3 = state and Color3.fromRGB(85, 255, 127) or Color3.fromRGB(255, 85, 85)
	end
	update()
	
	btn.Activated:Connect(function()
		state = not state
		update()
		callback(state, label)
	end)
end

