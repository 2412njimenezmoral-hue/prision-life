			pName.BackgroundTransparency = 1
			pName.Text = player.Name
			pName.TextColor3 = Color3.fromRGB(255, 255, 255)
			pName.Font = Enum.Font.GothamMedium
			pName.TextSize = 13
			pName.TextXAlignment = Enum.TextXAlignment.Left

			-- Botón Excluir
			local excBtn = Instance.new("TextButton", rowFrame)
			excBtn.Size = UDim2.new(0, 80, 0, 25)
			excBtn.Position = UDim2.new(1, -180, 0.5, -12.5)
			local isExc = config.exceptions[player.Name]
			excBtn.BackgroundColor3 = isExc and Color3.fromRGB(255, 85, 85) or Color3.fromRGB(45, 45, 55)
			excBtn.Text = isExc and "Excluded" or "Exclude"
			excBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			excBtn.Font = Enum.Font.GothamBold
			excBtn.TextSize = 11
			Instance.new("UICorner", excBtn).CornerRadius = UDim.new(0, 4)

			excBtn.Activated:Connect(function()
				config.exceptions[player.Name] = not config.exceptions[player.Name]
				refreshPlayerList() 
			end)

			-- Botón Prioridad
			local prioBtn = Instance.new("TextButton", rowFrame)
			prioBtn.Size = UDim2.new(0, 80, 0, 25)
			prioBtn.Position = UDim2.new(1, -90, 0.5, -12.5)
			local isCustom = (config.customTargetPlayer == player)
			prioBtn.BackgroundColor3 = isCustom and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(45, 45, 55)
			prioBtn.Text = isCustom and "★ Prio" or "Priority"
			prioBtn.TextColor3 = isCustom and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
			prioBtn.Font = Enum.Font.GothamBold
			prioBtn.TextSize = 11
			Instance.new("UICorner", prioBtn).CornerRadius = UDim.new(0, 4)

			prioBtn.Activated:Connect(function()
				if config.customTargetPlayer == player then
					config.customTargetPlayer = nil
